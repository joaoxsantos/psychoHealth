# Chave usada somente pelas rotas administrativas do backend.
# Gere uma chave longa e aleatória e mantenha o valor real apenas no arquivo .env
ADMIN_API_KEY=coloque_uma_chave_aleatoria_longa_aqui

# Configurações opcionais para desenvolvimento local
HOST=127.0.0.1
PORT=4173
NODE_ENV=development

# Opcional: pasta para armazenar o banco SQLite
# PSYCHOHEALTH_DATA_DIR=./backend/data
